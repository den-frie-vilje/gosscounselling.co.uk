{
  "name": "gosscounselling-co-uk",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "build:staging": "pnpm build --mode staging",
    "build:production": "pnpm build --mode production",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "precheck": "node scripts/gen-assets.ts",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-contrast.ts && node scripts/check-copy.ts && node scripts/check-deploy.ts && node scripts/run-gates.ts",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "og": "node scripts/gen-og.ts",
    "photos": "node scripts/gen-photos.ts",
    "prebuild": "node scripts/gen-assets.ts && node scripts/copy-sveltia.ts && node scripts/gen-photos.ts",
    "assets": "node scripts/gen-assets.ts",
    "assets:force": "node scripts/gen-assets.ts --force",
    "assets:list": "node scripts/gen-assets.ts --list",
    "cutouts": "node scripts/gen-cutouts.ts",
    "cutouts:selftest": "node scripts/gen-cutouts.ts --self-test",
    "check:cms": "node scripts/check-cms.ts",
    "check:cms:selftest": "node scripts/check-cms.ts --self-test",
    "check:build": "node scripts/check-posts.ts && node scripts/check-mock.ts",
    "check:posts": "node scripts/check-posts.ts",
    "check:posts:selftest": "node scripts/check-posts.ts --self-test",
    "check:mock": "node scripts/check-mock.ts",
    "check:seo": "node scripts/check-seo.ts",
    "check:contrast": "node scripts/check-contrast.ts",
    "check:portrait": "node scripts/check-portrait-fit.ts",
    "check:mattes": "node scripts/check-mattes.ts",
    "postbuild": "node scripts/gen-404.ts",
    "social:icons": "node scripts/gen-social-icons.ts",
    "check:publish": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && node scripts/check-contrast.ts && node scripts/check-copy.ts && node scripts/check-deploy.ts && node scripts/run-gates.ts --advisory",
    "check:content": "node scripts/run-gates.ts",
    "check:copy": "node scripts/check-copy.ts",
    "check:copy:selftest": "node scripts/check-copy.ts --self-test",
    "check:deploy": "node scripts/check-deploy.ts",
    "check:deploy:selftest": "node scripts/check-deploy.ts --self-test"
  },
  "engines": {
    "node": "~25",
    "pnpm": "~10"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.2.5",
    "@fontsource-variable/inter": "^5.2.5",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.63.0",
    "@sveltejs/mcp": "^0.1.20",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@sveltia/cms": "0.157.1",
    "@tailwindcss/vite": "^4.3.0",
    "bootstrap-icons": "^1.13.1",
    "satori": "^0.26.0",
    "satori-html": "^0.3.2",
    "sharp": "^0.35.2",
    "simple-icons": "^16.28.0",
    "svelte": "^5.56.1",
    "svelte-check": "^4.6.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "yaml": "^2.9.0"
  },
  "dependencies": {
    "marked": "^18.0.5"
  }
}
