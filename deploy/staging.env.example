# Copy to `staging.env` alongside compose.staging.yml on the NAS.
#
#   Path:        /volume1/docker/gosscounselling.co.uk/staging/staging.env
#   Permissions: 0640 root:docker
#
# This is the PER-STACK env file, consumed by the compose file's ${VAR}
# interpolation. It is a different file from the agent's per-(site, env)
# config at /volume1/docker/nas-sites/sites.d/<domain>.<env>.env, which
# holds the repo, branch and any Cloudflare token. The port lives here, in
# this file — which is why grepping sites.d/ for CADDY_PORT finds nothing.

# This site's canonical (production) domain.
DOMAIN=gosscounselling.co.uk

# Staging origin, dots replaced by dashes: the Let's Encrypt wildcard
# *.stage.denfrievilje.dk matches exactly one label, so the dots in
# gosscounselling.co.uk would put the host two labels deep and out of reach.
STAGE_ORIGIN=gosscounselling-co-uk.stage.denfrievilje.dk

# Host-side loopback port for the DSM reverse-proxy vhost.
#
# Allocation starts at 18080 on this NAS — the 80xx range collides with Jitsi.
# Confirm what is actually in use before committing to this number, and note
# the check reads the STACK env files, not the agent's:
#
#   grep -rh CADDY_PORT /volume1/docker/*/*/*.env
#   docker ps --format '{{.Names}}\t{{.Ports}}' | grep 127.0.0.1
#
# The *.env.example files in the sibling repos disagree with each other
# (skovbyesexologi and chrishemmings both show 18080 for staging; m-path and
# denfrievilje both show 18082), so they are not a reliable allocation table —
# the NAS is.
CADDY_PORT=18084
