# Front door for gosscounselling-co-uk.stage.denfrievilje.dk.
#
# DSM Web Station proxies the staging hostname to 127.0.0.1:${CADDY_PORT};
# this Caddy speaks plain HTTP on the docker network and routes by path:
#
#   /auth/*  → the GitHub OAuth proxy the editor signs in through
#   /*       → the built site

{
    admin off
    auto_https off
}

:80 {
    # The editor's sign-in. `handle_path` STRIPS the /auth prefix, and that
    # strip is the whole trick.
    #
    # Sveltia builds its URLs as `${base_url}/auth` and
    # `${base_url}/callback`, and base_url is
    # `https://gosscounselling-co-uk.stage.denfrievilje.dk/auth`
    # (static/admin/config.yml). So the browser asks for /auth/auth and
    # /auth/callback; after the strip the upstream sees /auth and /callback at
    # its own root, which is what netlify-cms-github-oauth-provider serves.
    # A plain `handle` instead of `handle_path` would forward the prefix and
    # every sign-in would 404.
    handle_path /auth/* {
        reverse_proxy sveltia-auth:3000
    }

    handle {
        reverse_proxy site:8080
    }

    encode gzip zstd

    # Belt and braces with the image's own robots.txt and meta: this is a
    # client's name, phone number and fee list sitting on a public hostname
    # while he decides. It must never enter an index.
    header X-Robots-Tag "noindex, nofollow, noarchive, nosnippet"

    # Prototypes change hourly — never serve a stale one.
    header Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    header Pragma "no-cache"
    header Expires "0"

    log {
        output stdout
        format json
    }
}
