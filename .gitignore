node_modules

# Output
/.svelte-kit
/build

# OS
.DS_Store
Thumbs.db

# Local-only secrets / overrides. The per-mode .env.production,
# .env.staging, .env.development files in this repo contain ONLY
# `PUBLIC_`-prefixed values, which Vite bakes into the public client
# bundle anyway (canonical site URL, GitHub repo name). They are NOT
# secrets — commit them so CI builds have them too. `.env` (unscoped)
# and `.env.*.local` stay ignored for developer-specific overrides.
.env
.env.local
.env.*.local

# Deploy env files — real values (OAuth client secrets etc.) live only
# on the NAS. The committed *.env.example files show the shape.
deploy/*.env
!deploy/*.env.example

# Sveltia CMS bundle — build artefact copied by scripts/copy-sveltia.ts
/static/admin/sveltia-cms.js

# Generated OG images — built by scripts/gen-og.ts in prebuild
/static/img/og/

# Responsive photo variants — built by scripts/gen-photos.ts in prebuild
/static/img/photos/_gen/

# The keyer's audit record. Written only when a photograph is actually keyed,
# and it names the file it keyed — so a committed one would describe a run that
# a fresh checkout has not made. scripts/check-mattes.ts stands its
# reproduction check down when it is absent, and says so.
/src/lib/generated/cutout-audit.json
