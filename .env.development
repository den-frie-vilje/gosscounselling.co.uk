# Public build-time env for `vite dev` (mode: development).
# PUBLIC_-only — baked into the client bundle, never secret —
# committed so a fresh checkout runs without setup and the
# `$env/static/public` imports always resolve.
PUBLIC_SITE_URL=http://localhost:5173
PUBLIC_GITHUB_REPO=den-frie-vilje/gosscounselling.co.uk

PUBLIC_ALLOW_INDEXING=false

# Build markers — CI passes real values via --build-arg (process
# env wins over these mode-file defaults); empty in local dev.
PUBLIC_GIT_SHA=
PUBLIC_BUILD_TIME=

# Which backend the generated /admin/config.yml carries. Dev matches staging
# (the localhost editor offers local-repository mode regardless).
PUBLIC_CMS_BACKEND=staging
